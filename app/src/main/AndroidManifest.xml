<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_ayam"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ResepAnakKost">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".DetailResepActivity" android:exported="false" />
        <activity android:name=".MasakActivity" android:exported="false" />
        <activity android:name=".TambahResepActivity" android:exported="false" />
    </application>

</manifest>
